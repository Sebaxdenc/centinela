<mxfile host="app.diagrams.net"><diagram id="centinela-arq" name="Arquitectura por capas"><mxGraphModel dx="1800" dy="1290" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="CENTINELA · Arquitectura de datos por capas" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=27.5;fontColor=#0d3b66;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="13" width="1000" height="40.6" as="geometry"/></mxCell><mxCell id="c3" value="Chiva Pay · detección de fraude en tiempo real y monitoreo SARLAFT · Entregable 1 · ST1630 Sistemas Intensivos en Datos · EAFIT" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=14.2;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="30" y="51" width="1000" height="21" as="geometry"/></mxCell><mxCell id="c4" value="Escala de diseño: 9 M tx/día · ≈ 20.000 ev/s en picos · 5,5 M clientes activos" style="text;html=1;align=right;verticalAlign=top;whiteSpace=nowrap;fontSize=14.2;fontColor=#1f2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="27" width="1000" height="21" as="geometry"/></mxCell><mxCell id="c5" value="Demo local en Docker Compose (MinIO expone la API S3)" style="text;html=1;align=right;verticalAlign=top;whiteSpace=nowrap;fontSize=14.2;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="780" y="51" width="1000" height="21" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#cfd6dd;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="290" height="990" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1 · FUENTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sistemas origen, formato y frecuencia&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d3b66;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="290" height="58" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#cfd6dd;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="340" y="82" width="310" height="990" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;2 · INGESTIÓN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Transporte y garantía de entrega&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d3b66;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="82" width="310" height="58" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#cfd6dd;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680" y="82" width="380" height="990" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;3 · PROCESAMIENTO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Qué cambia entre entrada y salida&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d3b66;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="680" y="82" width="380" height="58" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#cfd6dd;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1090" y="82" width="380" height="990" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;4 · ALMACENAMIENTO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bronze · Silver · Gold y serving&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d3b66;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1090" y="82" width="380" height="58" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#cfd6dd;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1500" y="82" width="280" height="990" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;5 · CONSUMO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Usuarios y sistemas sobre Gold&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0d3b66;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1500" y="82" width="280" height="58" as="geometry"/></mxCell><mxCell id="c16" value="Chiva Pay es una SEDPE con 9 M de clientes; 5,5 M usan la app cada mes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=12.3;fontColor=#5f6368;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="32" y="152" width="268" height="36.8" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;PostgreSQL&lt;/b&gt; · tabla outbox&lt;br&gt;&lt;b&gt;Formato:&lt;/b&gt; JSON&lt;br&gt;&lt;b&gt;Frecuencia:&lt;/b&gt; 9 M tx/día · pico 1.800/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="224" width="270" height="116" as="geometry"/></mxCell><mxCell id="c18" value="Core transaccional Chiva Pay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="224" width="270" height="28" as="geometry"/></mxCell><mxCell id="c19" value="Eventos de sesión y dispositivo&lt;br&gt;&lt;b&gt;Formato:&lt;/b&gt; JSON&lt;br&gt;&lt;b&gt;Frecuencia:&lt;/b&gt; 86 M ev/día · pico 18.000/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="270" height="116" as="geometry"/></mxCell><mxCell id="c20" value="App móvil Chiva Pay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="270" height="28" as="geometry"/></mxCell><mxCell id="c21" value="Decisiones: fraude, falso positivo o en investigación&lt;br&gt;&lt;b&gt;Formato:&lt;/b&gt; JSON · 1 evento por decisión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="270" height="116" as="geometry"/></mxCell><mxCell id="c22" value="Consola del analista" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="476" width="270" height="28" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font color=&quot;#5f6368&quot;&gt;Simulador (Entregable 2)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Un simulador Python genera estas fuentes entre 200 y 2.000 ev/s e inyecta fraude etiquetado al 0,5 %." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a929a;strokeWidth=1.4;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="270" height="140" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Maestros&lt;/b&gt; de clientes y comercios: Parquet&lt;br&gt;&lt;b&gt;Listas restrictivas&lt;/b&gt; ONU/OFAC: CSV&lt;br&gt;&lt;b&gt;Etiquetas de fraude&lt;/b&gt; confirmado (llegan hasta 60 días tarde)&lt;br&gt;&lt;b&gt;Frecuencia:&lt;/b&gt; diaria, con manifiesto SHA-256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="270" height="190" as="geometry"/></mxCell><mxCell id="c25" value="Archivos diarios en landing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="270" height="28" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=2.2;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="290" height="461" as="geometry"/></mxCell><mxCell id="c27" value="Apache Kafka 3.9 (KRaft, 3 brokers)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=14.7;fontColor=#0d3b66;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="362" y="152.5" width="1000" height="21.7" as="geometry"/></mxCell><mxCell id="c28" value="RF = 3 · min.insync.replicas = 2 · 12 particiones por topic · clave cliente_id · retención 7 días" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;fontSize=11.9;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="362" y="176" width="268" height="35.5" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Transporte:&lt;/b&gt; relay del outbox con productor idempotente (acks=all)&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; at-least-once; dedup por tx_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="360" y="224" width="270" height="116" as="geometry"/></mxCell><mxCell id="c30" value="tx.transacciones.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="224" width="270" height="28" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Transporte:&lt;/b&gt; productor idempotente (acks=all), orden por cliente&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; at-least-once; consumidores idempotentes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="270" height="116" as="geometry"/></mxCell><mxCell id="c32" value="app.eventos.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="270" height="28" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Transporte:&lt;/b&gt; productor de la consola (acks=all)&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; at-least-once; MERGE por alerta_id en Gold" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#455a64;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="360" y="476" width="270" height="116" as="geometry"/></mxCell><mxCell id="c34" value="fraude.decisiones.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#455a64;strokeColor=#455a64;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="476" width="270" height="28" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;&lt;font color=&quot;#5f6368&quot;&gt;Garantía extremo a extremo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;at-least-once + sinks idempotentes (checkpoint con Delta, alerta_id determinístico, MERGE por llave) = efecto exactly-once." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a929a;strokeWidth=1.4;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="350" y="630" width="290" height="140" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Transporte:&lt;/b&gt; carga batch por archivo (API S3); S3KeySensor deferrable detecta su llegada&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; exactly-once por archivo (tabla de control con ruta + SHA-256)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#1565c0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="350" y="860" width="290" height="190" as="geometry"/></mxCell><mxCell id="c37" value="MinIO · s3://landing/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="860" width="290" height="28" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Spark 3.5 Structured Streaming&lt;/b&gt; · trigger 5 s · watermark 15 min · estado RocksDB&lt;br&gt;&lt;b&gt;Entrada:&lt;/b&gt; transacciones y eventos de app (JSON), leídos directo de Kafka&lt;br&gt;&lt;b&gt;Cambia:&lt;/b&gt; ventanas de 10 min y 1 h por cliente, join con la sesión (±30 min) y reglas R1–R6 que dan un score&lt;br&gt;&lt;b&gt;Salida:&lt;/b&gt; alerta con alerta_id, score, regla y severidad&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; at-least-once, efecto exactly-once" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="360" height="268" as="geometry"/></mxCell><mxCell id="c39" value="[P2] detector_fraude  ·  ruta caliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="360" height="28" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Spark 3.5 Structured Streaming&lt;/b&gt; · trigger 30 s (Kafka) y carga batch de landing&lt;br&gt;&lt;b&gt;Cambia:&lt;/b&gt; nada del payload; agrega _topic, _partition, _offset, _ingest_ts&lt;br&gt;&lt;b&gt;Entrega:&lt;/b&gt; exactly-once (checkpoint + commit Delta)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#1565c0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="690" y="432" width="360" height="150" as="geometry"/></mxCell><mxCell id="c41" value="[P1] ingesta_bronze" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="432" width="360" height="28" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Spark 3.5 batch incremental&lt;/b&gt; · availableNow cada 15 min&lt;br&gt;&lt;b&gt;Cambia:&lt;/b&gt; valida tipos, monto &amp;gt; 0, COP y cliente; inválidos → cuarentena; dedup por tx_id; tokeniza documento y celular (HMAC-SHA-256)&lt;br&gt;&lt;b&gt;Salida:&lt;/b&gt; Silver limpio y sin PII" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#1565c0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="690" y="596" width="360" height="180" as="geometry"/></mxCell><mxCell id="c43" value="[P3] Bronze → Silver" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="596" width="360" height="28" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Spark 3.5 batch incremental&lt;/b&gt; · availableNow cada 15 min + MERGE por llave&lt;br&gt;&lt;b&gt;Entrada:&lt;/b&gt; Silver (transacciones, alertas y decisiones del analista)&lt;br&gt;&lt;b&gt;Cambia:&lt;/b&gt; une y modela en estrella; SCD2 en dim_cliente y dim_regla; las etiquetas tardías actualizan es_fraude_confirmado&lt;br&gt;&lt;b&gt;Salida:&lt;/b&gt; hechos y dimensiones de Gold, agg_kpi_fraude_diario y perfil_riesgo diario hacia Cassandra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#1565c0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="690" y="790" width="360" height="270" as="geometry"/></mxCell><mxCell id="c45" value="[P4] Silver → Gold" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1565c0;strokeColor=#1565c0;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="790" width="360" height="28" as="geometry"/></mxCell><mxCell id="c46" value="Tablas alertas_por_cliente, cola_alertas y perfil_riesgo (lookup de [P2], carga diaria desde [P4])&lt;br&gt;&lt;b&gt;RF = 3&lt;/b&gt; · escribe LOCAL_QUORUM, lee LOCAL_ONE (AP) · TTL 90/180 días" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="360" height="125" as="geometry"/></mxCell><mxCell id="c47" value="Apache Cassandra 5.0 · serving en vivo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="360" height="28" as="geometry"/></mxCell><mxCell id="c48" value="Topic de salida de [P2]; también llega a Bronze por [P1]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c62828;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.3;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="360" height="95" as="geometry"/></mxCell><mxCell id="c49" value="Kafka · fraude.alertas.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c62828;strokeColor=#c62828;strokeWidth=1.6;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="290" width="360" height="28" as="geometry"/></mxCell><mxCell id="c50" value="Ruta &lt;b&gt;s3a://centinela/&lt;/b&gt; · append-only&lt;br&gt;Payload crudo + linaje (_topic, _partition, _offset, _ingest_ts)&lt;br&gt;PII en claro, bucket restringido · retención 5 años" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7ebdd;strokeColor=#9c5a1a;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=34;fontSize=12.8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="360" height="182" as="geometry"/></mxCell><mxCell id="c51" value="BRONZE · Delta Lake 3.3 en MinIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9c5a1